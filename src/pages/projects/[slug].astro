---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const statusLabel: Record<string, string> = {
  shipped: 'Shipped',
  'in-progress': 'In progress',
  archived: 'Archived',
};

const formattedDate = new Date(project.data.date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
});
---

<Layout title={project.data.title} description={project.data.summary}>
  <div class="wrap">
    <div class="project-header">
      <span class="status">{statusLabel[project.data.status]}</span>
      <h1>{project.data.title}</h1>
      <p class="summary">{project.data.summary}</p>
    </div>

    <dl class="project-meta">
      <div>
        <dt class="field-label">Stack</dt>
        <dd>{project.data.stack.join(', ')}</dd>
      </div>
      {project.data.role && (
        <div>
          <dt class="field-label">Role</dt>
          <dd>{project.data.role}</dd>
        </div>
      )}
      <div>
        <dt class="field-label">Date</dt>
        <dd>{formattedDate}</dd>
      </div>
    </dl>

    <div class="project-links">
      {project.data.repoUrl && <a href={project.data.repoUrl}>Repository ↗</a>}
      {project.data.demoUrl && <a href={project.data.demoUrl}>Live demo ↗</a>}
    </div>

    <article class="prose">
      <Content />
    </article>

    <a href="/#projects">← Back to all projects</a>
  </div>
</Layout>
